# Copy to .env for local overrides. Dev-only credentials — never use in production.
PGSAFE_DEV_PG_USER=pgsafe
PGSAFE_DEV_PG_PASSWORD=pgsafe
PGSAFE_DEV_MINIO_USER=pgsafeminio
PGSAFE_DEV_MINIO_PASSWORD=pgsafeminio
PGSAFE_DEV_BUCKET=pgsafe-dev

# Connection strings used by tests / the agent in later phases
PG14_DATABASE_URL=postgres://pgsafe:pgsafe@localhost:5414/shop?sslmode=disable
PG16_DATABASE_URL=postgres://pgsafe:pgsafe@localhost:5416/shop?sslmode=disable
PG18_DATABASE_URL=postgres://pgsafe:pgsafe@localhost:5418/shop?sslmode=disable
STAGING_DATABASE_URL=postgres://pgsafe:pgsafe@localhost:5433/shop_staging?sslmode=disable
META_DATABASE_URL=postgres://pgsafe:pgsafe@localhost:5434/pgsafe_meta?sslmode=disable
S3_ENDPOINT=http://localhost:9000
