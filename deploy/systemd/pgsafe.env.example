# /etc/pgsafe/pgsafe.env — secrets for the pgsafe service (chmod 600, owner pgsafe).
# Referenced from pgsafe.yaml as ${NAME}; never written in the yaml itself.
PROD_DATABASE_URL=postgres://pgsafe_ro:CHANGE_ME@db.internal:5432/app?sslmode=require
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Only on machines that verify / mask (keep the private key file mode 0600):
PGSAFE_AGE_IDENTITY_FILE=/etc/pgsafe/keys/backup.key
PGSAFE_MASK_SALT=CHANGE_ME_openssl_rand_hex_32
STAGING_DATABASE_URL=postgres://pgsafe:CHANGE_ME@staging.internal:5432/app_staging
ALERT_WEBHOOK_URL=https://hooks.example.com/pgsafe
# Use local PostgreSQL clients from PGDG (postgresql-client-14..18):
# PGSAFE_PG_BIN_DIR=/usr/lib/postgresql/{major}/bin
